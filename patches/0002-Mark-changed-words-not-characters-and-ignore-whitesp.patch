+"""Word-level inline matching (local patch, not upstream Meld).
+
+Meld's stock inline highlighting compares character by character, so a
+re-indented block marks every added space and line break. This matcher
+compares words and punctuation instead and never looks at whitespace, so
+whitespace-only differences mark nothing, and a run of changed words is
+marked as one span, spaces included.
+
+It returns only the differing spans. Meld's highlighter also marks any
+"equal" match shorter than three characters, which at word level would
+mark every short token ("}", "(") on a re-indented line.
+"""
+
+import re
+from typing import List, Tuple
+
+from meld.matchers.myers import DiffChunk, MyersSequenceMatcher
+
+# A word, or any single character that is neither a word character nor
+# whitespace. Whitespace is never a token.
+TOKEN_RE = re.compile(r"\w+|[^\w\s]")
+
+Token = Tuple[str, int, int]
+
+
+def tokenise(text: str) -> List[Token]:
+    """(token, start offset, end offset) for every non-whitespace token."""
+    return [(m.group(), m.start(), m.end()) for m in TOKEN_RE.finditer(text)]
+
+
+def _char_span(tokens: List[Token], lo: int, hi: int) -> Tuple[int, int]:
+    """Character offsets covering tokens[lo:hi]. An empty range sits right
+    after the token before it, so an insertion marks nothing on that side."""
+    if lo < hi:
+        return tokens[lo][1], tokens[hi - 1][2]
+    pos = tokens[lo - 1][2] if lo > 0 else 0
+    return pos, pos
+
+
+def _gap_text(text: str, tokens: List[Token], lo: int, hi: int) -> str:
+    """The text from the end of the token before tokens[lo] to the start of
+    the token after tokens[hi - 1], whitespace included; either end falls
+    back to the start or end of the text."""
+    start = tokens[lo - 1][2] if lo > 0 else 0
+    end = tokens[hi][1] if hi < len(tokens) else len(text)
+    return text[start:end]
+
+
+def wants_inline_highlight(chunk) -> bool:
+    """Whether filediff should mark the changed words inside a chunk.
+
+    Stock Meld does this for "replace" chunks only. Conflicts get it too,
+    so the words that differ stand out there as well, but only when both
+    sides have lines: against an empty side every word would be marked,
+    which only repeats the chunk's own colour."""
+    if chunk.tag == "replace":
+        return True
+    return (chunk.tag == "conflict" and
+            chunk.start_a != chunk.end_a and chunk.start_b != chunk.end_b)
+
+
+class WordSequenceMatcher:
+    """Drop-in for InlineMyersSequenceMatcher in MatcherWorker: built as
+    (isjunk, a, b) on two strings, and get_opcodes() returns DiffChunks in
+    character offsets."""
+
+    def __init__(self, isjunk=None, a="", b=""):
+        if isjunk is not None:
+            raise NotImplementedError('isjunk is not supported')
+        self.a = a
+        self.b = b
+
+    def get_opcodes(self) -> List[DiffChunk]:
+        tokens_a = tokenise(self.a)
+        tokens_b = tokenise(self.b)
+        matcher = MyersSequenceMatcher(
+            None, [t[0] for t in tokens_a], [t[0] for t in tokens_b])
+        opcodes = matcher.get_opcodes()
+        chunks = []
+        for n, (tag, i1, i2, j1, j2) in enumerate(opcodes):
+            if tag == "equal":
+                continue
+            start_a, end_a = _char_span(tokens_a, i1, i2)
+            start_b, end_b = _char_span(tokens_b, j1, j2)
+            if chunks and self._bridges(opcodes[n - 1], tokens_a, tokens_b):
+                # Join this change to the previous one across the
+                # punctuation between them, so one edit reads as one span.
+                prev = chunks.pop()
+                tag = "replace"
+                start_a, start_b = prev.start_a, prev.start_b
+            chunks.append(DiffChunk(tag, start_a, end_a, start_b, end_b))
+        return chunks
+
+    def _bridges(self, equal, tokens_a, tokens_b) -> bool:
+        """Whether an equal run between two changes is only punctuation on
+        one line. A stray "?" or "(" that happens to match would otherwise
+        split one changed line into fragments; a matching word, or a line
+        break, keeps the two changes apart."""
+        _tag, i1, i2, j1, j2 = equal
+        if any(t[0][0].isalnum() or t[0][0] == "_" for t in tokens_a[i1:i2]):
+            return False
+        return ("\n" not in _gap_text(self.a, tokens_a, i1, i2) and
+                "\n" not in _gap_text(self.b, tokens_b, j1, j2))
