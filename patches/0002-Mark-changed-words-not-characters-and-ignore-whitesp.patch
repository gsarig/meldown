diff --git a/test/test_words.py b/test/test_words.py
new file mode 100644
index 0000000..9dfa35b
--- /dev/null
+++ b/test/test_words.py
@@ -0,0 +1,99 @@
+"""Tests for the word-level inline matcher (local patch).
+
+Assumptions pinned: Meld's MatcherWorker builds its matcher as
+matcher_class(None, text1, textn) and reads get_opcodes() as DiffChunks
+(tag, start_a, end_a, start_b, end_b) in character offsets; filediff
+highlights every non-equal chunk it gets back.
+"""
+
+import unittest
+
+from meld.matchers.myers import DiffChunk
+from meld.matchers.words import (
+    WordSequenceMatcher,
+    tokenise,
+    wants_inline_highlight,
+)
+
+
+def marked(a, b):
+    """The (a, b) substrings each chunk marks."""
+    chunks = WordSequenceMatcher(None, a, b).get_opcodes()
+    return [(a[c.start_a:c.end_a], b[c.start_b:c.end_b]) for c in chunks]
+
+
+class WordMatcherTests(unittest.TestCase):
+
+    def test_tokenise_skips_whitespace(self):
+        self.assertEqual(
+            [t[0] for t in tokenise("  foo(bar, 1)\n")],
+            ["foo", "(", "bar", ",", "1", ")"])
+
+    def test_identical_text_marks_nothing(self):
+        self.assertEqual(marked("a b c", "a b c"), [])
+
+    def test_whitespace_only_difference_marks_nothing(self):
+        # A re-indented block, wrapped lines and changed spacing.
+        a = "if (x) {\n  y();\n}\n"
+        b = "if (x) {\n        y();\n    }\n\n"
+        self.assertEqual(marked(a, b), [])
+
+    def test_changed_word_marks_only_that_word(self):
+        a = "<Container className={cn('flex flex-col gap-6 py-10')}>"
+        b = "<Container className={cn('py-10')}>"
+        self.assertEqual(marked(a, b), [("flex flex-col gap-6", "")])
+
+    def test_run_of_inserted_words_is_one_span_with_its_spaces(self):
+        a = "cn('gap-6 py-10')"
+        b = "cn('gap-6 py-10 lg:flex-row lg:items-center')"
+        self.assertEqual(marked(a, b), [("", "lg:flex-row lg:items-center")])
+
+    def test_replaced_word(self):
+        self.assertEqual(marked("level={1}", "level={2}"), [("1", "2")])
+
+    def test_insertion_at_start_and_empty_sides(self):
+        self.assertEqual(marked("b", "a b"), [("", "a")])
+        self.assertEqual(marked("", "x"), [("", "x")])
+        self.assertEqual(marked("x", ""), [("x", "")])
+
+    def test_matching_punctuation_does_not_split_a_changed_line(self):
+        # Meld's "(??)" conflict placeholder against a real line: the "?"s
+        # match, but the line should still read as one change.
+        a = "(??)"
+        b = "    cards?: { heading?: string }[];"
+        self.assertEqual(marked(a, b), [("(??)", "cards?: { heading?: string }[];")])
+
+    def test_matching_word_keeps_changes_apart(self):
+        self.assertEqual(
+            marked("a = foo(1)", "b = foo(2)"), [("a", "b"), ("1", "2")])
+
+    def test_punctuation_across_a_line_break_keeps_changes_apart(self):
+        a = "one(\n)two"
+        b = "uno(\n)dos"
+        self.assertEqual(marked(a, b), [("one", "uno"), ("two", "dos")])
+
+    def test_insertions_at_the_edges_do_not_fail(self):
+        self.assertEqual(marked("? x", "y ? x z"), [("", "y"), ("", "z")])
+        self.assertEqual(marked("a ?", "? b ?"), [("a", "? b")])
+
+    def test_offsets_are_characters_not_bytes(self):
+        a = "τίτλος old"
+        b = "τίτλος new"
+        self.assertEqual(marked(a, b), [("old", "new")])
+
+
+class InlineHighlightScopeTests(unittest.TestCase):
+
+    def test_replace_and_two_sided_conflicts_are_highlighted(self):
+        self.assertTrue(wants_inline_highlight(DiffChunk("replace", 1, 2, 1, 2)))
+        self.assertTrue(wants_inline_highlight(DiffChunk("conflict", 1, 3, 4, 5)))
+
+    def test_one_sided_conflicts_and_plain_inserts_are_not(self):
+        self.assertFalse(wants_inline_highlight(DiffChunk("conflict", 1, 1, 4, 5)))
+        self.assertFalse(wants_inline_highlight(DiffChunk("conflict", 1, 3, 4, 4)))
+        self.assertFalse(wants_inline_highlight(DiffChunk("insert", 1, 1, 4, 5)))
+        self.assertFalse(wants_inline_highlight(DiffChunk("delete", 1, 3, 4, 4)))
+
+
+if __name__ == "__main__":
+    unittest.main()
