From 774a9fb9f3ab1df2c271639b964519a80a249eab Mon Sep 17 00:00:00 2001
From: Giorgos Sarigiannidis <contact@gsarigiannidis.gr>
Date: Thu, 26 Nov 2026 00:02:00 +0200
Subject: [PATCH 9/9] Conflicts list: fall back to Tabs when the side panel
 does not fit the screen

---
 meld/conflictsview.py | 61 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 60 insertions(+), 1 deletion(-)

diff --git a/meld/conflictsview.py b/meld/conflictsview.py
index 35101d1..fcf8f8d 100644
--- a/meld/conflictsview.py
+++ b/meld/conflictsview.py
@@ -111,6 +111,8 @@ class ConflictsView(Gtk.Box, MeldDoc):
         self.layout = get_settings().get_string('conflicts-layout')
         self._applied = 'tabs'   # where the list is now; start() moves it
         self._quiet = False      # selection set by code, not by a click
+        self._fallback = False   # Tabs forced by a too-narrow screen
+        self._fit_handler = None  # (frame clock, handler id) while watched
         self._handlers = []      # (object, handler id) to drop on close
         self.switch_box = None
 
@@ -178,7 +180,10 @@ class ConflictsView(Gtk.Box, MeldDoc):
         if button.get_active():
             self.set_layout(layout)
             # Remembered, so the next Conflicts list starts in the layout
-            # used last.
+            # used last; not a fallback to Tabs, which only holds for
+            # this window and screen.
+            if self._fallback or self.layout != layout:
+                return
             settings = get_settings()
             if settings.get_string('conflicts-layout') != layout:
                 settings.set_string('conflicts-layout', layout)
@@ -223,6 +228,60 @@ class ConflictsView(Gtk.Box, MeldDoc):
                 if path is not None:
                     self.open_merge(path)
             self._update_stack()
+            self._watch_fit()
+
+    def _watch_fit(self):
+        """Check the fit at the start of every frame while the side panel
+        shows. The merge view keeps growing after it opens (its files load
+        later), so a check right after the switch sees it too small; the
+        frame clock's update phase comes before layout and paint, so a
+        fallback there lands before a too-wide window is ever drawn."""
+        if self._fit_handler is not None:
+            return
+        clock = self.window.get_frame_clock()
+        if clock is None:
+            # Not realized yet: start watching once it is.
+            self.window.connect('realize', lambda *args: self._watch_fit())
+            return
+        handler = clock.connect('update', self._on_frame_update)
+        self._fit_handler = (clock, handler)
+        self._handlers.append(self._fit_handler)
+
+    def _on_frame_update(self, clock):
+        if self._side() and not self._fits():
+            self._fall_back_to_tabs()
+
+    def _fits(self) -> bool:
+        """Whether the window's minimum width fits the monitor's work
+        area. The side panel adds its width to the merge view's, which is
+        already wide, and on a narrow or highly scaled screen the sum can
+        exceed the screen. Under Wayland (WSLg) the compositor then kills
+        Meld with a protocol error instead of letting the window overflow,
+        so this is checked right after the switch, before the next frame
+        is drawn at the new size."""
+        window = self.window
+        min_width, _ = window.get_preferred_width()
+        display = window.get_display()
+        gdk_window = window.get_window()
+        monitor = (display.get_monitor_at_window(gdk_window) if gdk_window
+                   else display.get_primary_monitor() or display.get_monitor(0))
+        if monitor is None:
+            return True
+        return min_width <= monitor.get_workarea().width
+
+    def _fall_back_to_tabs(self):
+        """Too narrow for the side panel: show Tabs for this window and
+        disable the Side panel button, leaving the saved choice alone so a
+        wider screen gets the side panel again next time."""
+        log.info('Side panel does not fit the screen, using Tabs')
+        self.side_toggle.set_sensitive(False)
+        self.side_toggle.set_tooltip_text(
+            'The screen is too narrow for the side panel')
+        self._fallback = True
+        try:
+            self.set_layout('tabs')
+        finally:
+            self._fallback = False
 
     def _side(self) -> bool:
         return self._applied == 'side'
