From c8bb9777e01b8f1a976f958dab95dff3c2c4fee3 Mon Sep 17 00:00:00 2001
From: Giorgos Sarigiannidis <contact@gsarigiannidis.gr>
Date: Wed, 11 Nov 2026 19:40:32 +0200
Subject: [PATCH 1/7] Show the count of conflicts left in the merge pane's
 status bar

Meld tracks the conflicts it could not merge but never shows how many
are left. Write 'N conflicts' in red, or 'No conflicts' in green, into
the middle pane's status bar, refreshed after every edit.
---
 meld/filediff.py | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/meld/filediff.py b/meld/filediff.py
index c01b8a8..461f174 100644
--- a/meld/filediff.py
+++ b/meld/filediff.py
@@ -1938,6 +1938,25 @@ class FileDiff(Gtk.Box, MeldDoc):
 
     def on_diffs_changed(self, linediffer, chunk_changes):
 
+        # Local patch: show how many
+        # conflicts are left in the middle pane's status bar, refreshed on
+        # every diff update, so it counts down while resolving a merge. It
+        # writes markup straight into the status bar's message label, which
+        # Meld never uses, since push() would reset the label to plain text.
+        if self.num_panes == 3:
+            label = next(
+                child for child in
+                self.statusbar[1].get_message_area().get_children()
+                if isinstance(child, Gtk.Label))
+            count = len(self.linediffer.conflicts)
+            if count:
+                label.set_markup(
+                    f'<span foreground="#f75464" weight="bold">{count} '
+                    f'conflict{"s" if count != 1 else ""}</span>')
+            else:
+                label.set_markup(
+                    '<span foreground="#6aab73">No conflicts</span>')
+
         for pane in range(self.num_panes):
             pane_changes = list(self.linediffer.single_changes(pane))
             self.chunkmap[pane].chunks = pane_changes
