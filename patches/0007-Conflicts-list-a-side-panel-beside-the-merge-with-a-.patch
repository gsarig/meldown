+    def _on_toggled(self, button, layout):
+        if button.get_active():
+            self.set_layout(layout)
+            # Remembered, so the next Conflicts list starts in the layout
+            # used last.
+            settings = get_settings()
+            if settings.get_string('conflicts-layout') != layout:
+                settings.set_string('conflicts-layout', layout)
+
+    def set_layout(self, layout: str):
+        """Move the list between its own tab and the side area. The merge
+        tabs never move; in the side view their tab strip is hidden and
+        the list picks which one shows."""
+        layout = 'side' if layout == 'side' else 'tabs'
+        self.layout = layout
+        toggle = self.side_toggle if layout == 'side' else self.tabs_toggle
+        if not toggle.get_active():
+            toggle.set_active(True)
+        if layout == self._applied:
+            return
+        window, notebook = self.window, self.window.notebook
+        if layout == 'side':
+            num = notebook.page_num(self)
+            if num >= 0:
+                if notebook.get_current_page() == num:
+                    self.on_container_switch_out_event(window)
+                notebook.remove_page(num)
+            window.side_area.pack_start(self, True, True, 0)
+            window.side_area.show()
+            window.side_doc = self
+            notebook.set_tabs_hidden(True)
+        else:
+            window.side_area.remove(self)
+            window.side_area.hide()
+            window.side_doc = None
+            notebook.set_tabs_hidden(False)
+            window.add_notebook_page(self, 0)
+            notebook.on_label_changed(self, self.label_text, self.tooltip_text)
+            window.content_stack.set_visible_child_name('notebook')
+            notebook.set_current_page(notebook.page_num(self))
+        self._applied = layout
+        self.merge_button.set_visible(layout == 'tabs')
+        self.refresh()
+        if layout == 'side':
+            if not self.tabs:
+                path = self._next_mergeable()
+                if path is not None:
+                    self.open_merge(path)
+            self._update_stack()
+
+    def _side(self) -> bool:
+        return self._applied == 'side'
+
+    def _update_stack(self, note: Optional[str] = None):
+        """In the side view, show the open merge, or a note when none is."""
+        if not self._side():
+            return
+        stack = self.window.content_stack
+        if self.window.notebook.get_n_pages() and note is None:
+            stack.set_visible_child_name('notebook')
+            return
+        if note is None:
+            note = ('Select a file to merge it' if self._unresolved() else
+                    'Nothing left to resolve: Accept and finish stages the '
+                    'files and closes Meld')
+        stack.get_child_by_name('placeholder').set_text(note)
+        stack.set_visible_child_name('placeholder')
+        if not self.window.notebook.get_n_pages():
+            # No merge is shown, so the header bar shows the list's own
+            # buttons, as switching to the Conflicts tab does.
+            MeldDoc.on_container_switch_in_event(self, self.window)
+
+    def _on_window_active(self, window, *args):
+        # In the side view the list is never switched to, which is what
+        # refreshes it in the tab view, so git commands run elsewhere show
+        # up when the window gets focus back.
+        if self._side() and window.is_active() and not window.closing:
+            self.refresh()
+
+    def _on_switch_page(self, notebook, page, page_num):
+        if not self._side():
+            return
+        path = next((p for p, doc in self.tabs.items() if doc is page), None)
+        if path is not None:
+            self._select(path)
+        self._update_marks()
