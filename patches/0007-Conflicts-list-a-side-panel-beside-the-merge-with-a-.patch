+    def _side_row(self, path, note=None, accept=False, selectable=True):
+        """A compact row for the side view: the file name with its folder
+        under it, and for an unresolved file Accept yours / Accept theirs,
+        always shown but clickable only on the selected row."""
+        folder, name = os.path.split(path)
+        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
+        name_label = self._label(GLib.markup_escape_text(name))
+        text.pack_start(name_label, False, False, 0)
+        sub = ' · '.join(x for x in (folder, note) if x)
+        if sub:
+            text.pack_start(self._label(_dim(sub)), False, False, 0)
+        children = [(text, True)]
+        accept_box = None
+        if accept:
+            accept_box = Gtk.Box(spacing=6)
+            for stage, label in ((OURS, 'Accept yours'), (THEIRS, 'Accept theirs')):
+                button = Gtk.Button.new_with_label(label)
+                button.connect('clicked', lambda *a, s=stage: self.accept(path, s))
+                accept_box.pack_start(button, False, False, 0)
+            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
+            outer.pack_start(text, False, False, 0)
+            outer.pack_start(accept_box, False, False, 0)
+            children = [(outer, True)]
+        row = self._row(children, selectable=selectable, path=path)
+        row.name_label = name_label
+        row.name = name
+        row.accept_box = accept_box
+        return row
+
+    def _update_marks(self):
+        """In the side view: Accept buttons clickable on the selected row
+        only (shown on every row, so nothing appears or vanishes), and a
+        dot on each file that is open and not finished."""
+        selected = self.listbox.get_selected_row()
+        for row in self.listbox.get_children():
+            if row.accept_box is not None:
+                row.accept_box.set_sensitive(row is selected)
+            if row.name_label is not None:
+                dot = '● ' if self._unfinished(row.path) else ''
+                row.name_label.set_markup(
+                    GLib.markup_escape_text(dot + row.name))
+
+    def _unfinished(self, path) -> bool:
+        # A merge closes once it is saved with nothing unresolved, so every
+        # file still open is unfinished, including one still loading.
+        return path in self.tabs
+
+    def _select(self, path):
+        """Select a file's row without opening it."""
+        self._quiet = True
+        try:
+            for row in self.listbox.get_children():
+                if getattr(row, 'path', None) == path:
+                    self.listbox.select_row(row)
+                    break
+        finally:
+            self._quiet = False
+
+    def _next_mergeable(self, skip=None):
+        """The first unresolved file that has a merge view and is not
+        open, for the side view to show next."""
+        for path in self._unresolved():
+            if path != skip and path not in self.tabs and self._can_merge(path):
+                return path
+        return None
+
+    def _relabel_merges(self):
+        """Tell each open merge which layout it is in, for its save button."""
+        for path, doc in self.tabs.items():
+            has_next = any(p != path for p in self._unresolved())
+            doc.anchored.set_from_list(self._applied, has_next)
+
