diff --git a/meld/conflicts.py b/meld/conflicts.py
index 993fd78..f6a5384 100644
--- a/meld/conflicts.py
+++ b/meld/conflicts.py
@@ -119,3 +119,21 @@ def auto_resolve(contents: Dict[int, bytes]) -> Optional[bytes]:
     if model.counts()[1]:
         return None
     return join_lines(result, newline).encode('utf-8')
+
+
+# -- closing the window with the list in the side view ----------------------
+# Kept here, without GTK, so they can be tested; meld/meldwindow.py uses them.
+
+def ask_list_on_close(responses: List[int], ok: int) -> bool:
+    """Whether a window closing with the Conflicts list in its side area
+    should ask the list too. Only when every tab agreed to close: the list
+    reports Meld's exit status and lets the application end, which must not
+    happen while a cancelled or still-saving tab keeps the window open."""
+    return all(response == ok for response in responses)
+
+
+def is_notebook_page(page_num: int) -> bool:
+    """Whether a closing document is a notebook tab. The list in the side
+    area is not, and its page number is -1, which Gtk.Notebook.remove_page
+    would read as "the last tab"."""
+    return page_num >= 0
