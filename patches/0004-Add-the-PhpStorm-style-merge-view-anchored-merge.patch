diff --git a/meld/anchoredview.py b/meld/anchoredview.py
new file mode 100644
index 0000000..a41ac53
--- /dev/null
+++ b/meld/anchoredview.py
@@ -0,0 +1,400 @@
+# Copyright (C) 2026 Giorgos Sarigiannidis
+#
