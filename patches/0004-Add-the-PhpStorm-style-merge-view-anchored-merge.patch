+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+"""The base-anchored merge view (local patch, not upstream Meld).
+
+A three-way FileDiff opened with --anchored-merge gets one of these. It
+works like PhpStorm's merge window: the result starts as the base, every
+change has an arrow that applies it and an X that dismisses it, a toolbar
+applies all non-conflicting changes or runs the magic wand, and a counter
+shows what is left. The state lives in meld/matchers/anchored.py; this
+module only draws it and turns clicks into edits of the result buffer.
+
+FileDiff calls in at a handful of hook points (look for "anchored" in
+filediff.py), so the patch to Meld's own files stays small.
+"""
+
+import logging
+from typing import List, Optional
+
+from gi.repository import Gdk, GLib, Gtk
+
+from meld import misc
+from meld.matchers.anchored import (
+    LEFT,
+    RIGHT,
+    Edit,
+    SideState,
+    exit_status,
+)
+
+log = logging.getLogger(__name__)
+
+CONFLICT_MARKERS = ('<<<<<<<', '>>>>>>>')
+APPLIED_TAG = 'anchored-applied'
+DISMISSED_TAG = 'anchored-dismissed'
+
+# Gutter indexes in FileDiff.actiongutter: left pane -> result, and right
+# pane -> result. The two result -> side gutters show nothing here.
+GUTTERS = {LEFT: 0, RIGHT: 3}
+
+
+def read_saved_result(path: Optional[str]) -> Optional[str]:
+    """The merge output's text when it is a result saved earlier, or None:
+    missing, unreadable, or still holding git's conflict markers (a fresh
+    conflict, which starts from the base instead)."""
+    if not path:
+        return None
+    try:
+        with open(path, 'rb') as handle:
+            text = handle.read().decode('utf-8')
+    except (OSError, UnicodeDecodeError):
+        return None
+    for line in text.splitlines():
+        if line.startswith(CONFLICT_MARKERS):
+            return None
+    return text
+
+
+class AnchoredView:
+
+    def __init__(self, filediff):
+        self.fd = filediff
+        self.saved_resolved = False
+        self.edited_since_save = True
+        self._close_after_save = False
+        self._build_toolbars()
+        for side, index in GUTTERS.items():
+            gutter = filediff.actiongutter[index]
+            gutter.props.width_request = 40
+            gutter.connect('anchored-action-activated', self.on_action)
+        for gutter in filediff.actiongutter:
+            gutter.anchored_buttons = []
+        for buf in filediff.textbuffer:
+            buf.create_tag(
+                APPLIED_TAG,
+                paragraph_background_rgba=Gdk.RGBA(0.27, 0.44, 0.32, 0.22))
+            buf.create_tag(
+                DISMISSED_TAG, strikethrough=True,
+                foreground_rgba=Gdk.RGBA(0.44, 0.45, 0.48, 1.0))
+
+    # -- widgets ---------------------------------------------------------------
+
+    def _button(self, label, callback, tooltip=None):
+        button = Gtk.Button.new_with_label(label)
+        button.get_style_context().add_class('flat')
+        button.connect('clicked', lambda *args: callback())
+        if tooltip:
+            button.set_tooltip_text(tooltip)
+        return button
+
+    def _build_toolbars(self):
+        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
+        top.props.margin = 4
+        top.pack_start(self._button('↑', lambda: self.go_to_change(-1),
+                                    'Previous unresolved change'), False, False, 0)
+        top.pack_start(self._button('↓', lambda: self.go_to_change(1),
+                                    'Next unresolved change'), False, False, 0)
+        top.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL),
+                       False, False, 6)
+        label = Gtk.Label(label='Apply non-conflicting changes:')
+        label.get_style_context().add_class('dim-label')
+        top.pack_start(label, False, False, 4)
+        top.pack_start(self._button('» Left', lambda: self.apply_non_conflicting('left')),
+                       False, False, 0)
+        top.pack_start(self._button('»« All', lambda: self.apply_non_conflicting('all')),
+                       False, False, 0)
+        top.pack_start(self._button('« Right', lambda: self.apply_non_conflicting('right')),
+                       False, False, 0)
+        top.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL),
+                       False, False, 6)
+        top.pack_start(self._button(
+            '✨ Simple conflicts', self.resolve_simple,
+            'Merge conflicts whose two sides changed different words'),
+            False, False, 0)
+        self.counter = Gtk.Label()
+        top.pack_end(self.counter, False, False, 8)
+
+        bottom = Gtk.ActionBar()
+        bottom.pack_start(self._button('Accept left', lambda: self.accept_file(LEFT),
+                                       'Take the whole left file'))
+        bottom.pack_start(self._button('Accept right', lambda: self.accept_file(RIGHT),
+                                       'Take the whole right file'))
+        save = Gtk.Button.new_with_label('Save and close')
+        save.get_style_context().add_class('suggested-action')
+        save.set_tooltip_text(
+            'Save the result and close it; Ctrl+S saves without closing')
+        save.connect('clicked', lambda *args: self.save_and_close())
+        bottom.pack_end(save)
+        self.bottom = bottom
+
+        self.fd.pack_start(top, False, False, 0)
+        self.fd.reorder_child(top, 0)
+        self.fd.pack_end(bottom, False, False, 0)
+        top.show_all()
+        bottom.show_all()
+
+    # -- hooks from FileDiff ---------------------------------------------------
+
+    @property
+    def model(self):
+        return self.fd.linediffer.model
+
+    def prepare(self):
+        """Run in place of FileDiff._merge_files, once every pane has loaded:
+        the middle pane holds the base. Remember it, and when the merge
+        output is a result saved earlier, start from that instead."""
+        fd = self.fd
+        base = list(fd.buffer_texts[1])
+        fd.linediffer.base_lines = base
+        bufdata = fd.textbuffer[1].data
+        path = bufdata.savefile.get_path() if bufdata.savefile else None
+        saved = read_saved_result(path)
+        self._reopened = False
+        # Compared the way BufferLines splits: a final line break leaves an
+        # empty last line, and no line keeps its "\r".
+        if saved is not None and [
+                line.rstrip('\r') for line in saved.split('\n')] != base:
+            fd.textbuffer[1].set_text(saved)
+            self._reopened = True
+        yield 1
+
+    def compared(self):
+        """Run once the comparison is ready (from on_diffs_changed): watch
+        the result for edits, and count a reopened file that was already
+        fully resolved as saved."""
+        if getattr(self, '_watching', False) or self.model is None:
+            return
+        self._watching = True
+        if self._reopened and self.model.counts()[1] == 0:
+            self.saved_resolved = True
+            self.edited_since_save = False
+        self.fd.textbuffer[1].connect('changed', self.on_result_changed)
+
+    def on_result_changed(self, buf):
+        self.edited_since_save = True
+
+    def on_saved(self):
+        model = self.model
+        self.saved_resolved = model is not None and model.counts()[1] == 0
+        self.edited_since_save = False
+        if self._close_after_save:
+            self._close_after_save = False
+            GLib.idle_add(self._close)
+
+    def save_and_close(self):
+        """Save the result, then close: the whole window when this is its
+        only tab (git mergetool waits for Meld to exit before the next
+        file), otherwise just this tab. With changes still unresolved it
+        asks first, since closing then leaves the file unresolved in git.
+        Nothing closes when the save does not start or fails, so a problem
+        stays on screen."""
+        model = self.model
+        unresolved = model.counts()[1] if model is not None else 0
+        if unresolved and not self._confirm_unresolved(unresolved):
+            return
+        self._close_after_save = bool(self.fd.save_file(1))
+
+    def _confirm_unresolved(self, unresolved: int) -> bool:
+        primary = (f'{unresolved} change{"s are" if unresolved != 1 else " is"}'
+                   ' still unresolved')
+        secondary = ('If you save and close now, the file stays unresolved '
+                     'and git mergetool will ask whether to go on to the '
+                     'next file.')
+        response = misc.modal_dialog(
+            primary, secondary,
+            (('_Keep resolving', Gtk.ResponseType.CANCEL, None),
+             ('_Save and close anyway', Gtk.ResponseType.OK,
+              'destructive-action')),
+            parent=self.fd, messagetype=Gtk.MessageType.QUESTION)
+        return response == Gtk.ResponseType.OK
+
+    def _close(self):
+        window = self.fd.get_toplevel()
+        notebook = getattr(window, 'notebook', None)
+        if notebook is not None and notebook.get_n_pages() == 1:
+            window.close()
+        else:
+            self.fd.on_delete_event()
+        return GLib.SOURCE_REMOVE
+
+    def exit_status(self) -> int:
+        return exit_status(self.saved_resolved, self.edited_since_save)
+
+    def conflict_count(self) -> int:
+        return self.model.counts()[2] if self.model is not None else 0
+
+    def on_diffs_changed(self):
+        if self.model is None:
+            return
+        self.compared()
+        self._update_buttons()
+        self._update_counter()
+        self._update_tags()
+
+    # -- drawing ---------------------------------------------------------------
+
+    def _update_buttons(self):
+        model = self.model
+        for side, gutter_index in GUTTERS.items():
+            arrow = 'apply-right' if side == LEFT else 'apply-left'
+            buttons = []
+            for group in model.groups:
+                rng = group.sides[side]
+                if rng is None:
+                    continue
+                if model.side_state(group.index, side) != SideState.UNRESOLVED:
+                    continue
+                apply = (arrow, 'apply', group.index, side)
+                dismiss = ('delete', 'dismiss', group.index, side)
+                # The arrow sits next to the result pane, as in PhpStorm.
+                actions = [dismiss, apply] if side == LEFT else [apply, dismiss]
+                buttons.append((rng[0], actions))
+            gutter = self.fd.actiongutter[gutter_index]
+            gutter.anchored_buttons = buttons
+            gutter.queue_draw()
+
+    def _update_counter(self):
+        changes, unresolved, conflicts = self.model.counts()
+        text = f'{changes} change{"s" if changes != 1 else ""} · '
+        text += f'<b>{unresolved} unresolved</b> · '
+        colour = '#f75464' if conflicts else '#6aab73'
+        text += (f'<span foreground="{colour}">{conflicts} '
+                 f'conflict{"s" if conflicts != 1 else ""}</span>')
+        self.counter.set_markup(text)
+
+    def _tag_lines(self, buf, tag, start, end):
+        if start >= end:
+            return
+        buf.apply_tag_by_name(
+            tag, buf.get_iter_at_line_or_eof(start),
+            buf.get_iter_at_line_or_eof(end))
+
+    def _update_tags(self):
+        model = self.model
+        bufs = self.fd.textbuffer
+        for buf in bufs[:3]:
+            start, end = buf.get_bounds()
+            buf.remove_tag_by_name(APPLIED_TAG, start, end)
+            buf.remove_tag_by_name(DISMISSED_TAG, start, end)
+        side_bufs = {LEFT: bufs[0], RIGHT: bufs[2]}
+        for group in model.groups:
+            any_applied = False
+            for side in (LEFT, RIGHT):
+                rng = group.sides[side]
+                if rng is None:
+                    continue
+                state = model.side_state(group.index, side)
+                if state == SideState.APPLIED:
+                    any_applied = True
+                    self._tag_lines(side_bufs[side], APPLIED_TAG, *rng)
+                elif state == SideState.DISMISSED:
+                    self._tag_lines(side_bufs[side], DISMISSED_TAG, *rng)
+            if any_applied:
+                self._tag_lines(bufs[1], APPLIED_TAG, *model.ranges[group.index])
+
+    # -- actions ---------------------------------------------------------------
+
+    def refresh(self):
+        """Re-tag after a state change that edits no text."""
+        self.fd.linediffer.refresh(self.fd.buffer_filtered[:3])
+
+    def apply_edits(self, edits: List[Edit]):
+        """Apply model edits (last first) to the result as one undo step."""
+        if not edits:
+            return
+        buf = self.fd.textbuffer[1]
+        buf.begin_user_action()
+        try:
+            for edit in edits:
+                self._apply_edit(buf, edit)
+        finally:
+            buf.end_user_action()
+        buf.place_cursor(buf.get_iter_at_line_or_eof(edits[-1].start))
+
+    def _apply_edit(self, buf, edit: Edit):
+        """Replace result lines [start, end) with the edit's lines. The last
+        line of a GtkTextBuffer never has a line break, so edits that reach
+        the end of the buffer drop the final break, or the one before."""
+        count = buf.get_line_count()
+        if edit.start >= count:
+            if edit.lines:
+                buf.insert(buf.get_end_iter(), '\n' + '\n'.join(edit.lines))
+            return
+        start = buf.get_iter_at_line(edit.start)
+        if edit.end >= count:
+            end = buf.get_end_iter()
+            text = '\n'.join(edit.lines)
+            if not edit.lines and edit.start > 0:
+                start.backward_char()
+        else:
+            end = buf.get_iter_at_line(edit.end)
+            text = ''.join(line + '\n' for line in edit.lines)
+        buf.delete(start, end)
+        buf.insert(start, text)
+
+    def on_action(self, gutter, action, index, side):
+        model = self.model
+        if model is None:
+            return
+        if action == 'apply':
+            edit = model.apply(index, side)
+            if edit is not None:
+                self.apply_edits([edit])
+        elif action == 'dismiss':
+            model.dismiss(index, side)
+            self.refresh()
+
+    def apply_non_conflicting(self, which: str):
+        if self.model is not None:
+            self.apply_edits(self.model.apply_non_conflicting(which))
+
+    def resolve_simple(self):
+        if self.model is not None:
+            self.apply_edits(self.model.wand_all())
+
+    def accept_file(self, side: int):
+        """Take one side's whole file, and dismiss every change from the
+        other side so nothing is left to resolve."""
+        model = self.model
+        if model is None:
+            return
+        source = model.left if side == LEFT else model.right
+        self.apply_edits([Edit(0, self.fd.textbuffer[1].get_line_count(), list(source))])
+        for group in model.groups:
+            for s in (LEFT, RIGHT):
+                if model.side_state(group.index, s) == SideState.UNRESOLVED:
