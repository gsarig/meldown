From: Giorgos Sarigiannidis <contact@gsarigiannidis.gr>
Date: Thu, 12 Nov 2026 15:50:31 +0200
Subject: [PATCH 6/6] Conflicts tab: say how many files Resolve simple
 conflicts would merge, grey out empty groups

The button now reads 'Resolve simple conflicts (N files)' and is greyed out
when no unresolved file merges without a real conflict, so it no longer
looks like it will do something it will not. A group with no files keeps
its place but is drawn in grey, so an empty Unresolved or Resolved header
does not draw the eye with its colour.
---
 meld/conflictsview.py | 75 +++++++++++++++++++++++++++++++------------
 1 file changed, 54 insertions(+), 21 deletions(-)

diff --git a/meld/conflictsview.py b/meld/conflictsview.py
index 89acd3c..d0abac5 100644
--- a/meld/conflictsview.py
+++ b/meld/conflictsview.py
@@ -210,9 +210,16 @@ class ConflictsView(Gtk.Box, MeldDoc):
         button.connect('clicked', lambda *a: self.accept(path, stage))
         return self._cell(button, BUTTON_WIDTH)
 
-    def _group(self, mark, title, count, note=''):
-        text = f'{mark} <b>{GLib.markup_escape_text(title)}</b> '
-        text += _dim(f'{count} file{"s" if count != 1 else ""}')
+    def _group(self, glyph, colour, title, count, note=''):
+        files = f'{count} file{"s" if count != 1 else ""}'
+        if count:
+            text = (f'<span foreground="{colour}">{glyph}</span> '
+                    f'<b>{GLib.markup_escape_text(title)}</b> ' + _dim(files))
+        else:
+            # An empty group stays in place, so rows do not jump as files
+            # move between groups, but in grey, so its colour does not
+            # draw the eye.
+            text = _dim(f'{glyph} {title} {files}')
         if note:
             text += '  ' + _dim(note)
         self._row([(self._label(text), True)], selectable=False)
@@ -250,8 +257,7 @@ class ConflictsView(Gtk.Box, MeldDoc):
         ], selectable=False)
 
         unresolved = self._unresolved()
-        self._group('<span foreground="#f75464">✕</span>', 'Unresolved',
-                    len(unresolved))
+        self._group('✕', '#f75464', 'Unresolved', len(unresolved))
         for path in unresolved:
             stages = self.current[path]
             cells = [(self._file_label(path, ''), True)]
@@ -262,15 +268,15 @@ class ConflictsView(Gtk.Box, MeldDoc):
 
         auto = self._pending_auto()
         if auto:
