-            except (OSError, subprocess.CalledProcessError):
-                continue
-            if not mergeable(stages, contents):
-                continue
-            contents.setdefault(BASE, b'')
-            merged = auto_resolve(contents)
-            if merged is None:
-                continue
+        for path, merged in self._simple().items():
             try:
                 with open(os.path.join(self.repo, path), 'wb') as handle:
                     handle.write(merged)
