                           path=path)
 
         resolved = sorted(p for p in self.initial if p not in self.current)
-        self._group('<span foreground="#6aab73">✓</span>', 'Resolved', len(resolved))
+        self._group('✓', '#6aab73', 'Resolved', len(resolved))
         for path in resolved:
             self._row([(self._file_label(path, ''), True),
                        (self._label(_dim(self.outcome.get(path, 'resolved'))), False)],
@@ -286,6 +292,7 @@ class ConflictsView(Gtk.Box, MeldDoc):
                           if getattr(r, 'path', None)), None)
             if first is not None:
                 self.listbox.select_row(first)
+        self._update_simple()
         self._update_buttons()
 
     def _update_buttons(self):
@@ -301,6 +308,43 @@ class ConflictsView(Gtk.Box, MeldDoc):
         else:
             self.hint.set_text('All conflicts resolved')
 
+    def _simple(self) -> Dict[str, bytes]:
+        """Each unresolved file that merges word by word with no real
+        conflict, with its merged text. A file open in a merge tab is left
+        to that tab."""
+        found = {}
+        for path in self._unresolved():
+            if path in self.tabs:
+                continue
+            try:
+                stages, contents = self._contents(path)
+            except (OSError, subprocess.CalledProcessError):
+                continue
+            if not mergeable(stages, contents):
+                continue
+            contents.setdefault(BASE, b'')
+            merged = auto_resolve(contents)
+            if merged is not None:
+                found[path] = merged
+        return found
+
+    def _update_simple(self):
+        """Say how many files the button would merge, and grey it out
+        when there are none, so it never looks like it will do something
+        it will not."""
+        count = len(self._simple())
+        label = '✨ Resolve simple conflicts'
+        if count:
+            label += f' ({count} file{"s" if count != 1 else ""})'
+            self.simple_button.set_tooltip_text(
+                'Merge every file whose changes do not overlap, word by word; '
+                'they go to Auto-resolved for review')
+        else:
+            self.simple_button.set_tooltip_text(
+                'Every unresolved file has a real conflict to resolve by hand')
+        self.simple_button.set_label(label)
+        self.simple_button.set_sensitive(bool(count))
+
     def _contents(self, path):
         stages = self.current.get(path, set())
         return stages, {s: stage_bytes(self.repo, path, s) for s in stages}
@@ -365,6 +409,7 @@ class ConflictsView(Gtk.Box, MeldDoc):
         doc.close_signal.connect(
             lambda _doc, status: self.on_merge_closed(path, status))
         self.tabs[path] = doc
+        self._update_simple()
         notebook.set_current_page(notebook.page_num(doc))
 
     def on_merge_closed(self, path, status):
@@ -410,19 +455,7 @@ class ConflictsView(Gtk.Box, MeldDoc):
         """Merge every unresolved file that has no real conflict, word by
         word, and move it to Auto-resolved without staging it."""
         done = 0
-        for path in self._unresolved():
-            if path in self.tabs:
