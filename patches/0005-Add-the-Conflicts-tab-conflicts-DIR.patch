+"""Git and text helpers for the Conflicts tab (local patch, not upstream).
+
+Kept free of GTK so they can be tested on their own; the tab itself is
+meld/conflictsview.py.
+
+Stages follow git's index: 1 is the common base, 2 "ours" (the side
+shown on the left, "yours"), 3 "theirs" (the right). In a rebase git
+swaps what ours and theirs mean; the wrapper script names the columns.
+"""
+
+import os
+import subprocess
+from typing import Dict, List, Optional, Set, Tuple
+
+from meld.matchers.anchored import AnchoredMerge, apply_edits
+
+BASE, OURS, THEIRS = 1, 2, 3
+BINARY_PROBE = 8192
+
+
+def git(repo: str, *args: str, input: Optional[bytes] = None) -> bytes:
+    """Run git in repo and return its stdout; raises CalledProcessError."""
+    return subprocess.run(
+        ['git', *args], cwd=repo, input=input, check=True,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout
+
+
+def parse_unmerged(output: bytes) -> Dict[str, Set[int]]:
+    """Paths and the stages they have, from `git ls-files -u -z`."""
+    paths: Dict[str, Set[int]] = {}
+    for record in output.split(b'\0'):
+        if not record:
+            continue
+        info, _tab, path = record.partition(b'\t')
+        stage = int(info.split()[2])
+        paths.setdefault(os.fsdecode(path), set()).add(stage)
+    return paths
+
+
+def unmerged(repo: str) -> Dict[str, Set[int]]:
+    return parse_unmerged(git(repo, 'ls-files', '-u', '-z'))
+
+
+def side_status(stages: Set[int], stage: int) -> str:
+    """How one side changed the file: Modified, Added or Deleted."""
+    if stage not in stages:
+        return 'Deleted'
+    return 'Modified' if BASE in stages else 'Added'
+
+
+def is_binary(data: bytes) -> bool:
+    return b'\0' in data[:BINARY_PROBE]
+
+
+def stage_bytes(repo: str, path: str, stage: int) -> bytes:
+    return git(repo, 'show', f':{stage}:{path}')
+
+
+def mergeable(stages: Set[int], contents: Dict[int, bytes]) -> bool:
+    """Whether the file can open in the merge view: both sides exist (a
+    side that deleted the file leaves only Accept) and neither is binary."""
+    if OURS not in stages or THEIRS not in stages:
+        return False
+    return not any(is_binary(contents.get(s, b'')) for s in (OURS, THEIRS))
+
+
+def split_text(text: str) -> Tuple[List[str], str]:
+    """Lines as Meld's buffers give them (no line endings, a final empty
+    line after a trailing line break) and the line break the text uses."""
+    newline = '\r\n' if '\r\n' in text else '\n'
+    return [line.rstrip('\r') for line in text.split('\n')], newline
+
+
+def join_lines(lines: List[str], newline: str) -> str:
+    return newline.join(lines)
+
+
+def decode(data: bytes) -> Optional[str]:
+    """Text of a stage, or None when it is not UTF-8 (such files are left
+    for the merge view, which knows more encodings)."""
+    try:
+        return data.decode('utf-8')
+    except UnicodeDecodeError:
+        return None
+
+
+def auto_resolve(contents: Dict[int, bytes]) -> Optional[bytes]:
+    """The whole file merged without a person: every non-conflicting change
+    applied and every conflict through the magic wand, or None when
+    anything is left. The result keeps the "ours" side's line breaks and is
+    written back as UTF-8, the encoding all three stages decoded from."""
+    texts = {s: decode(contents.get(s, b'')) for s in (BASE, OURS, THEIRS)}
+    if any(t is None for t in texts.values()):
+        return None
+    left, newline = split_text(texts[OURS])
+    base, _ = split_text(texts[BASE])
+    right, _ = split_text(texts[THEIRS])
+
+    model = AnchoredMerge(left, base, right)
+    result = apply_edits(list(model.result), model.apply_non_conflicting('all'))
+    model = AnchoredMerge(left, base, right, result)
+    result = apply_edits(result, model.wand_all())
+    model = AnchoredMerge(left, base, right, result)
+    if model.counts()[1]:
+        return None
+    return join_lines(result, newline).encode('utf-8')
