@@ -0,0 +1,120 @@
+"""Tests for the Conflicts tab's git and text helpers (local patch).
+
+Assumptions pinned: `git ls-files -u -z` prints "<mode> <sha> <stage>\\t<path>"
+records separated by NUL, one per stage present; stage 1 is the base, 2
+ours, 3 theirs.
+"""
+
+import os
+import subprocess
+import tempfile
+import unittest
+
+from meld.conflicts import (
+    auto_resolve,
+    is_binary,
+    mergeable,
+    parse_unmerged,
+    side_status,
+    split_text,
+    unmerged,
+)
+
+SHA = "0" * 40
+
+
+def record(stage, path):
+    return f"100644 {SHA} {stage}\t{path}".encode() + b"\0"
+
+
+class ParseTests(unittest.TestCase):
+
+    def test_parse_unmerged_groups_stages_by_path(self):
+        out = (record(1, "a.txt") + record(2, "a.txt") + record(3, "a.txt") +
+               record(1, "dir/b c.txt") + record(2, "dir/b c.txt"))
+        self.assertEqual(parse_unmerged(out),
+                         {"a.txt": {1, 2, 3}, "dir/b c.txt": {1, 2}})
+
+    def test_side_status(self):
+        self.assertEqual(side_status({1, 2, 3}, 2), "Modified")
+        self.assertEqual(side_status({1, 2}, 3), "Deleted")
+        self.assertEqual(side_status({2, 3}, 2), "Added")
+
+    def test_mergeable(self):
+        text = {2: b"a\n", 3: b"b\n"}
+        self.assertTrue(mergeable({1, 2, 3}, text))
+        self.assertTrue(mergeable({2, 3}, text))           # add/add
+        self.assertFalse(mergeable({1, 2}, text))          # theirs deleted
+        self.assertFalse(mergeable({1, 2, 3}, {2: b"a\0", 3: b"b"}))
+        self.assertTrue(is_binary(b"x\0y"))
+        self.assertFalse(is_binary(b"plain"))
+
+
+class TextTests(unittest.TestCase):
+
+    def test_split_text_keeps_the_trailing_empty_line_and_the_line_break(self):
+        self.assertEqual(split_text("a\r\nb\r\n"), (["a", "b", ""], "\r\n"))
+        self.assertEqual(split_text("a\nb"), (["a", "b"], "\n"))
+
+    def test_auto_resolve_merges_non_overlapping_changes(self):
+        base = b"one\ntwo\nthree\nfour\nfive\n"
+        ours = b"ONE\ntwo\nthree\nfour\nfive\n"
+        theirs = b"one\ntwo\nthree\nfour\nFIVE\n"
+        self.assertEqual(auto_resolve({1: base, 2: ours, 3: theirs}),
+                         b"ONE\ntwo\nthree\nfour\nFIVE\n")
+
+    def test_auto_resolve_uses_the_wand_on_word_edits(self):
+        base = b"cn('flex gap-6 py-10')\n"
+        ours = b"cn('py-10')\n"
+        theirs = b"cn('flex gap-6 py-10 lg:flex-row')\n"
+        self.assertEqual(auto_resolve({1: base, 2: ours, 3: theirs}),
+                         b"cn('py-10 lg:flex-row')\n")
+
+    def test_auto_resolve_keeps_crlf_line_breaks(self):
+        base = b"one\r\ntwo\r\nthree\r\nfour\r\n"
+        ours = b"ONE\r\ntwo\r\nthree\r\nfour\r\n"
+        theirs = b"one\r\ntwo\r\nthree\r\nFOUR\r\n"
+        self.assertEqual(auto_resolve({1: base, 2: ours, 3: theirs}),
+                         b"ONE\r\ntwo\r\nthree\r\nFOUR\r\n")
+
+    def test_auto_resolve_gives_up_on_a_true_conflict_or_non_utf8(self):
+        self.assertIsNone(auto_resolve({1: b"a\n", 2: b"b\n", 3: b"c\n"}))
+        self.assertIsNone(auto_resolve({1: b"a\n", 2: b"\xff\n", 3: b"a\n"}))
+
+
+class GitTests(unittest.TestCase):
+
+    def test_unmerged_reads_a_real_conflict(self):
+        with tempfile.TemporaryDirectory() as repo:
+            def run(*args):
+                subprocess.run(["git", *args], cwd=repo, check=True,
+                               capture_output=True)
+            run("init", "-q", "-b", "main")
+            run("config", "user.name", "t")
+            run("config", "user.email", "t@example.invalid")
+            def out(*args, input=None):
+                return subprocess.run(
+                    ["git", *args], cwd=repo, check=True, input=input,
+                    capture_output=True).stdout.decode().strip()
+            path = os.path.join(repo, "f.txt")
+            with open(path, "w") as f:
+                f.write("x\n")
+            run("add", "f.txt")
+            run("commit", "-qm", "base")
+            base = out("rev-parse", "HEAD")
+            # "theirs" is committed with plumbing, so the checked-out
+            # branch never changes.
+            blob = out("hash-object", "-w", "--stdin", input=b"theirs\n")
+            tree = out("mktree", input=f"100644 blob {blob}\tf.txt\n".encode())
+            theirs = out("commit-tree", tree, "-p", base, "-m", "theirs")
+            run("update-ref", "refs/heads/other", theirs)
+            with open(path, "w") as f:
+                f.write("ours\n")
+            run("commit", "-qam", "ours")
+            subprocess.run(["git", "merge", "other"], cwd=repo,
+                           capture_output=True)
+            self.assertEqual(unmerged(repo), {"f.txt": {1, 2, 3}})
+
+
+if __name__ == "__main__":
+    unittest.main()
