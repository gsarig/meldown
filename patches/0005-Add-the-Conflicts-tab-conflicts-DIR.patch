+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+"""The Conflicts tab (local patch, not upstream Meld).
+
+`meld --conflicts DIR` opens this tab, the repository's conflicts in a
+Meld tab: every conflicted file of the repo, its Yours and Theirs status
+with an Accept button each, Resolve all simple conflicts, and Accept and
+finish. A file opens in the anchored merge view (meld/anchoredview.py) in
+a tab of its own; saving it with nothing unresolved stages it and brings
+the list back.
+
+The column titles and the header come from the wrapper script through
+MELD_CONFLICTS_YOURS, MELD_CONFLICTS_THEIRS and MELD_CONFLICTS_HEADER, so
+the branch naming (which flips in a rebase) lives in one place.
+"""
+
+import atexit
+import logging
+import os
+import shutil
+import subprocess
+import tempfile
+from typing import Dict, Optional, Set
+
+from gi.repository import Gio, GLib, Gtk, Pango
+
+from meld import misc
+from meld.conflicts import (
+    BASE,
+    OURS,
+    THEIRS,
+    auto_resolve,
+    git,
+    mergeable,
+    side_status,
+    stage_bytes,
+    unmerged,
+)
+from meld.melddoc import MeldDoc
+from meld.recent import RecentType
+
+log = logging.getLogger(__name__)
+
+STATUS_WIDTH = 110
+BUTTON_WIDTH = 90
+
+
+def _dim(text: str) -> str:
+    return f'<span alpha="60%">{GLib.markup_escape_text(text)}</span>'
+
+
+class ConflictsView(Gtk.Box, MeldDoc):
+
+    __gtype_name__ = 'ConflictsView'
+
+    # A GObject subclass of two GObject bases only gets the first base's
+    # signals, so MeldDoc's are declared again, as FileDiff does.
+    close_signal = MeldDoc.close_signal
+    create_diff_signal = MeldDoc.create_diff_signal
+    file_changed_signal = MeldDoc.file_changed_signal
+    label_changed = MeldDoc.label_changed
+    move_diff = MeldDoc.move_diff
+    tab_state_changed = MeldDoc.tab_state_changed
+
+    def __init__(self, window, repo: str):
+        super().__init__(orientation=Gtk.Orientation.VERTICAL)
+        # Same workaround as FileDiff: GObject does not chain this init.
+        MeldDoc.__init__(self)
+        self.window = window
+        self.repo = repo
+        self.label_text = 'Conflicts'
+        self.tooltip_text = repo
+        self.yours = os.environ.get('MELD_CONFLICTS_YOURS') or 'Yours'
+        self.theirs = os.environ.get('MELD_CONFLICTS_THEIRS') or 'Theirs'
+        self.header = os.environ.get('MELD_CONFLICTS_HEADER') or ''
+        self.tmpdir = tempfile.mkdtemp(prefix='meld-conflicts-')
+        atexit.register(shutil.rmtree, self.tmpdir, True)
+        self._opened = 0
+
+        try:
+            self.initial = set(unmerged(repo))
+        except (OSError, subprocess.CalledProcessError) as err:
+            self.initial = set()
+            log.error('Cannot read conflicts in %s: %s', repo, err)
+        self.current: Dict[str, Set[int]] = {}
+        self.auto: Set[str] = set()       # written by the wand, not staged
+        self.outcome: Dict[str, str] = {}  # how a resolved file was done
+        self.tabs: Dict[str, object] = {}  # path -> its merge FileDiff
+        self.finished = False
+
+        self._build()
+        self.show_all()
+        self.refresh()
+
+    # -- MeldDoc ---------------------------------------------------------------
+
+    def get_comparison(self):
+        return RecentType.VersionControl, [Gio.File.new_for_path(self.repo)]
+
+    def next_diff(self, direction):
+        pass
+
+    def on_container_switch_in_event(self, window):
+        super().on_container_switch_in_event(window)
+        self.refresh()
+
+    def on_delete_event(self):
+        self.scheduler.remove_all_tasks()
+        self.close_signal.emit(self.exit_status())
+        return Gtk.ResponseType.OK
+
+    def exit_status(self) -> int:
+        if self.finished:
+            return 0
+        return 1 if self._unresolved() or self._pending_auto() else 0
+
+    # -- layout ----------------------------------------------------------------
+
+    def _build(self):
+        self.props.margin = 16
+        self.props.spacing = 12
+
+        header = Gtk.Label(xalign=0)
+        header.set_line_wrap(True)
+        header.set_markup(self.header or GLib.markup_escape_text(self.repo))
+        self.pack_start(header, False, False, 0)
+
+        top = Gtk.Box(spacing=8)
+        self.simple_button = Gtk.Button.new_with_label(
+            '✨ Resolve all simple conflicts')
+        self.simple_button.set_tooltip_text(
+            'Merge every file whose changes do not overlap, word by word; '
+            'they go to Auto-resolved for review')
+        self.simple_button.connect('clicked', lambda *a: self.resolve_simple())
+        top.pack_start(self.simple_button, False, False, 0)
+        self.pack_start(top, False, False, 0)
+
+        self.listbox = Gtk.ListBox()
+        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
+        self.listbox.set_activate_on_single_click(False)
+        self.listbox.connect('row-activated', self.on_row_activated)
+        self.listbox.connect('row-selected', lambda *a: self._update_buttons())
+        scroller = Gtk.ScrolledWindow()
+        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
+        scroller.add(self.listbox)
+        frame = Gtk.Frame()
+        frame.add(scroller)
+        self.pack_start(frame, True, True, 0)
+
+        bottom = Gtk.Box(spacing=8)
+        self.hint = Gtk.Label(xalign=0)
+        self.hint.get_style_context().add_class('dim-label')
+        self.hint.set_ellipsize(Pango.EllipsizeMode.END)
+        bottom.pack_start(self.hint, True, True, 0)
+        close = Gtk.Button.new_with_label('Close')
+        close.connect('clicked', lambda *a: self.window.close())
+        self.finish_button = Gtk.Button.new_with_label('Accept and finish')
+        self.finish_button.set_tooltip_text(
+            'Stage the auto-resolved files and close Meld')
+        self.finish_button.connect('clicked', lambda *a: self.finish())
+        self.merge_button = Gtk.Button.new_with_label('Merge')
+        self.merge_button.get_style_context().add_class('suggested-action')
+        self.merge_button.connect('clicked', lambda *a: self.open_selected())
+        for button in (close, self.finish_button, self.merge_button):
+            bottom.pack_end(button, False, False, 0)
+        self.bottom_buttons = (close, self.finish_button, self.merge_button)
+        self.pack_start(bottom, False, False, 0)
+
+    def _cell(self, widget, width=None):
+        if width:
+            widget.set_size_request(width, -1)
+        return widget
+
+    def _row(self, children, selectable=True, path=None, css=None):
+        row = Gtk.ListBoxRow()
+        row.set_selectable(selectable)
+        row.set_activatable(selectable)
+        row.path = path
+        box = Gtk.Box(spacing=8)
+        box.props.margin = 6
+        for widget, expand in children:
+            box.pack_start(widget, expand, expand, 0)
+        row.add(box)
+        if css:
+            row.get_style_context().add_class(css)
+        self.listbox.add(row)
+        return row
+
+    def _label(self, markup, width=None, xalign=0.0):
+        label = Gtk.Label(xalign=xalign)
+        label.set_markup(markup)
+        label.set_ellipsize(Pango.EllipsizeMode.END)
+        return self._cell(label, width)
+
+    def _accept_button(self, path, stage):
+        button = Gtk.Button.new_with_label('Accept')
+        button.connect('clicked', lambda *a: self.accept(path, stage))
+        return self._cell(button, BUTTON_WIDTH)
+
+    def _group(self, mark, title, count, note=''):
+        text = f'{mark} <b>{GLib.markup_escape_text(title)}</b> '
+        text += _dim(f'{count} file{"s" if count != 1 else ""}')
+        if note:
+            text += '  ' + _dim(note)
+        self._row([(self._label(text), True)], selectable=False)
+
+    def _file_label(self, path, mark):
+        folder, name = os.path.split(path)
+        text = f'{mark}  {GLib.markup_escape_text(name)}'
+        if folder:
+            text += '  ' + _dim(folder)
+        return self._label(text)
+
+    # -- state -----------------------------------------------------------------
+
+    def _unresolved(self):
+        return sorted(p for p in self.current if p not in self.auto)
+
+    def _pending_auto(self):
+        return sorted(p for p in self.auto if p in self.current)
+
+    def refresh(self):
+        try:
+            self.current = unmerged(self.repo)
+        except (OSError, subprocess.CalledProcessError) as err:
+            log.error('Cannot read conflicts in %s: %s', self.repo, err)
+            return
+        selected = self.listbox.get_selected_row()
+        selected = getattr(selected, 'path', None)
+        for child in self.listbox.get_children():
+            self.listbox.remove(child)
+
+        self._row([
+            (self._label(_dim('File')), True),
+            (self._label(_dim(self.yours), STATUS_WIDTH + BUTTON_WIDTH + 8), False),
+            (self._label(_dim(self.theirs), STATUS_WIDTH + BUTTON_WIDTH + 8), False),
+        ], selectable=False)
+
+        unresolved = self._unresolved()
+        self._group('<span foreground="#f75464">✕</span>', 'Unresolved',
+                    len(unresolved))
+        for path in unresolved:
+            stages = self.current[path]
+            cells = [(self._file_label(path, ''), True)]
+            for stage in (OURS, THEIRS):
+                cells.append((self._label(side_status(stages, stage), STATUS_WIDTH), False))
+                cells.append((self._accept_button(path, stage), False))
+            self._row(cells, path=path)
+
+        auto = self._pending_auto()
+        if auto:
+            self._group('<span foreground="#e5c07b">✨</span>', 'Auto-resolved',
+                        len(auto), 'open one to check it; Accept and finish stages them')
+            for path in auto:
+                self._row([(self._file_label(path, ''), True),
+                           (self._label(_dim('merged, not staged yet')), False)],
+                          path=path)
+
+        resolved = sorted(p for p in self.initial if p not in self.current)
+        self._group('<span foreground="#6aab73">✓</span>', 'Resolved', len(resolved))
+        for path in resolved:
+            self._row([(self._file_label(path, ''), True),
+                       (self._label(_dim(self.outcome.get(path, 'resolved'))), False)],
+                      selectable=False)
+
+        self.listbox.show_all()
+        for row in self.listbox.get_children():
+            if getattr(row, 'path', None) and row.path == selected:
+                self.listbox.select_row(row)
+                break
+        else:
+            first = next((r for r in self.listbox.get_children()
+                          if getattr(r, 'path', None)), None)
+            if first is not None:
+                self.listbox.select_row(first)
+        self._update_buttons()
+
+    def _update_buttons(self):
+        row = self.listbox.get_selected_row()
+        path = getattr(row, 'path', None)
+        self.merge_button.set_sensitive(bool(path) and self._can_merge(path))
+        self.finish_button.set_sensitive(not self._unresolved())
+        if self._unresolved():
+            self.hint.set_text('Double-click a file to merge it')
+        elif self._pending_auto():
+            self.hint.set_text('Nothing left to resolve; Accept and finish '
+                               'stages the auto-resolved files')
+        else:
+            self.hint.set_text('All conflicts resolved')
+
+    def _contents(self, path):
+        stages = self.current.get(path, set())
+        return stages, {s: stage_bytes(self.repo, path, s) for s in stages}
+
+    def _can_merge(self, path):
+        try:
+            stages, contents = self._contents(path)
+        except (OSError, subprocess.CalledProcessError):
+            return False
+        return mergeable(stages, contents)
+
+    def _error(self, primary, err):
+        detail = getattr(err, 'stderr', b'') or str(err)
+        if isinstance(detail, bytes):
+            detail = detail.decode('utf-8', 'replace')
+        misc.error_dialog(primary=primary,
+                          secondary=GLib.markup_escape_text(detail.strip()))
+
+    # -- actions ---------------------------------------------------------------
+
+    def on_row_activated(self, listbox, row):
+        if getattr(row, 'path', None):
+            self.open_merge(row.path)
+
+    def open_selected(self):
+        row = self.listbox.get_selected_row()
+        if getattr(row, 'path', None):
+            self.open_merge(row.path)
+
+    def open_merge(self, path):
+        """Open a file in the anchored merge view, in a tab of its own, or
+        switch to its tab when it is open already."""
+        tab = self.tabs.get(path)
+        notebook = self.window.notebook
+        if tab is not None and notebook.page_num(tab) >= 0:
+            notebook.set_current_page(notebook.page_num(tab))
+            return
+        try:
+            stages, contents = self._contents(path)
+        except (OSError, subprocess.CalledProcessError) as err:
+            self._error(f'Could not read the versions of {path}', err)
+            return
+        if not mergeable(stages, contents):
+            misc.error_dialog(
+                primary=f'{path} cannot be merged here',
+                secondary='One side deleted it or it is binary; use its '
+                          'Accept buttons instead.')
+            return
+        self._opened += 1
+        name = os.path.basename(path)
+        files = []
+        for stage in (OURS, BASE, THEIRS):
+            temp = os.path.join(self.tmpdir, f'{self._opened}-{stage}-{name}')
+            with open(temp, 'wb') as handle:
+                handle.write(contents.get(stage, b''))
+            files.append(Gio.File.new_for_path(temp))
+        output = Gio.File.new_for_path(os.path.join(self.repo, path))
+        doc = self.window.append_filemerge(
+            files, merge_output=output, anchored=True)
+        doc.set_labels([self.yours, f'Result: {path}', self.theirs])
+        doc.anchored.set_from_list()
+        doc.close_signal.connect(
+            lambda _doc, status: self.on_merge_closed(path, status))
+        self.tabs[path] = doc
+        notebook.set_current_page(notebook.page_num(doc))
+
+    def on_merge_closed(self, path, status):
+        """A merge tab closed: status 0 means it was saved with nothing
+        unresolved, so the file is staged."""
+        self.tabs.pop(path, None)
+        if status == 0:
+            try:
+                git(self.repo, 'add', '--', path)
+                self.outcome[path] = 'merged'
+                self.auto.discard(path)
+            except (OSError, subprocess.CalledProcessError) as err:
+                self._error(f'Could not stage {path}', err)
+        notebook = self.window.notebook
+        if notebook.page_num(self) >= 0:
+            notebook.set_current_page(notebook.page_num(self))
+        self.refresh()
+
+    def accept(self, path, stage):
+        """Take one side's whole file: its version (or its deletion) is
+        staged, with no merge view."""
+        stages = self.current.get(path, set())
+        tab = self.tabs.get(path)
+        if tab is not None and self.window.notebook.page_num(tab) >= 0:
+            if tab.on_delete_event() != Gtk.ResponseType.OK:
+                return
+        side = '--ours' if stage == OURS else '--theirs'
+        try:
+            if stage in stages:
+                git(self.repo, 'checkout', side, '--', path)
+                git(self.repo, 'add', '--', path)
+            else:
+                git(self.repo, 'rm', '-q', '--', path)
+        except (OSError, subprocess.CalledProcessError) as err:
+            self._error(f'Could not accept {path}', err)
+            return
+        who = self.yours if stage == OURS else self.theirs
+        self.outcome[path] = f'took {who}'
+        self.auto.discard(path)
+        self.refresh()
+
+    def resolve_simple(self):
+        """Merge every unresolved file that has no real conflict, word by
+        word, and move it to Auto-resolved without staging it."""
+        done = 0
+        for path in self._unresolved():
+            if path in self.tabs:
+                continue
+            try:
+                stages, contents = self._contents(path)
+            except (OSError, subprocess.CalledProcessError):
+                continue
+            if not mergeable(stages, contents):
+                continue
+            contents.setdefault(BASE, b'')
+            merged = auto_resolve(contents)
+            if merged is None:
+                continue
+            try:
+                with open(os.path.join(self.repo, path), 'wb') as handle:
+                    handle.write(merged)
+            except OSError as err:
+                self._error(f'Could not write {path}', err)
+                continue
+            self.auto.add(path)
+            done += 1
+        self.refresh()
+        if not done:
+            self.hint.set_text('No file could be merged without you')
+
+    def finish(self):
+        """Stage the auto-resolved files and close Meld."""
+        for path in self._pending_auto():
+            try:
+                git(self.repo, 'add', '--', path)
+                self.outcome[path] = 'auto-resolved'
+            except (OSError, subprocess.CalledProcessError) as err:
+                self._error(f'Could not stage {path}', err)
+                return
+        self.finished = True
+        self.window.close()
+
+
+ConflictsView.set_css_name('conflicts-view')
