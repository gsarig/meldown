+"""A base-anchored three-way merge (local patch, not upstream Meld).
+
+Stock Meld diffs the result pane against each side and recomputes after
+every edit, so a change it applied simply stops being a difference and a
+dismissed change comes straight back. This module instead fixes the
+changes once, against the common base, and tracks each one's state, as
+follows:
+
+- Change groups are worked out once from base->left and base->right. In a
+  merge the left, base and right texts never change, only the result does.
+- Each group's place in the result comes from a base->result line diff,
+  kept up to date incrementally as the result is edited.
+- A side's state is read from the result text, never stored: it is applied
+  when the result there equals that side's text (or, for a conflict, both
+  sides joined, or the magic wand's merge). Undo, typing and reopening a
+  half-done file therefore all follow from one rule. Only dismissals (the
+  X) are stored, as the text they were made against; one holds only while
+  the result there still has that text.
+
+AnchoredMergeDiffer feeds this into the rest of Meld by keeping Meld's own
+result<->side chunks, so pane alignment and link maps keep working, and
+re-tagging each chunk by the state of the group it covers.
+
+Texts are lists of lines without line endings, as Meld's BufferLines give
+them; lines are only compared, never edited, here.
+"""
+
+import enum
+import re
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Sequence, Tuple
+
+from meld.matchers.diffutil import Differ
+from meld.matchers.myers import DiffChunk
+
+LEFT, RIGHT = 0, 1
+
+Range = Tuple[int, int]
+# A base->result difference: (base_lo, base_hi, result_lo, result_hi).
+Chunk = Tuple[int, int, int, int]
+
+
+class Kind(enum.Enum):
+    LEFT = 'left'          # only the left side changed this block
+    RIGHT = 'right'        # only the right side changed it
+    BOTH = 'both'          # both sides made the same change
+    CONFLICT = 'conflict'  # the sides changed it differently
+
+
+class SideState(enum.Enum):
+    NONE = 'none'              # this side did not change this block
+    UNRESOLVED = 'unresolved'
+    APPLIED = 'applied'
+    DISMISSED = 'dismissed'
+
+
+HANDLED = (SideState.NONE, SideState.APPLIED, SideState.DISMISSED)
+
+
+@dataclass
+class Group:
+    index: int
+    kind: Kind
+    base: Range
+    # Each side's range in its own text, or None when it has no change here.
+    sides: Tuple[Optional[Range], Optional[Range]]
+
+
+@dataclass
+class Edit:
+    """Replace result lines [start, end) with lines."""
+    start: int
+    end: int
+    lines: List[str]
+
+
+def exit_status(saved_resolved: bool, edited_since_save: bool) -> int:
+    """Meld's exit status for a merge: 0 only when the result was saved with
+    nothing unresolved and not edited since, so `git mergetool` (with
+    trustExitCode) never marks a half-done or unsaved file resolved."""
+    return 0 if saved_resolved and not edited_since_save else 1
+
+
+# Whitespace runs, words and single punctuation characters: every character
+# of the text belongs to exactly one token, so joining them rebuilds it.
+WAND_TOKEN_RE = re.compile(r"\s+|\w+|[^\w\s]")
+
+
+def merge3(left: Sequence, base: Sequence, right: Sequence) -> Optional[list]:
+    """A plain three-way merge of any sequences: every change from either
+    side applied to base, or None when two changes overlap differently."""
+    differ = Differ()
+    for _ in differ.set_sequences_iter([left, base, right]):
+        pass
+    out, pos = [], 0
+    for c0, c1 in differ.all_changes():
+        if c0 is not None and c1 is not None and c0.tag == 'conflict':
+            return None
+        chunk, source = (c0, left) if c0 is not None else (c1, right)
+        out.extend(base[pos:chunk.start_a])
+        out.extend(source[chunk.start_b:chunk.end_b])
+        pos = chunk.end_a
+    out.extend(base[pos:])
+    return out
+
+
+def wand_merge(left: List[str], base: List[str],
+               right: List[str]) -> Optional[List[str]]:
+    """The magic wand: merge a conflicting block word by word. A line-level
+    conflict is often two edits to different words of the same lines (one
+    side removes classes, the other adds some), which merge cleanly here.
+    None when the sides still change the same words differently."""
+    def tokens(block):
+        return WAND_TOKEN_RE.findall("\n".join(block))
+
+    merged = merge3(tokens(left), tokens(base), tokens(right))
+    if merged is None:
+        return None
+    text = "".join(merged)
+    return text.split("\n") if text else []
+
+
+def build_groups(left, base, right) -> List[Group]:
+    """The change groups between base and the two sides, using Meld's own
+    three-way grouping (Differ._merge_diffs), which tags overlapping
+    changes as conflicts."""
+    differ = Differ()
+    for _ in differ.set_sequences_iter([left, base, right]):
+        pass
+    groups = []
+    for c0, c1 in differ.all_changes():
+        if c0 is not None and c1 is not None:
+            kind = Kind.CONFLICT if c0.tag == 'conflict' else Kind.BOTH
+        else:
+            kind = Kind.LEFT if c0 is not None else Kind.RIGHT
+        either = c0 if c0 is not None else c1
+        groups.append(Group(
+            index=len(groups),
+            kind=kind,
+            base=(either.start_a, either.end_a),
+            sides=(
+                (c0.start_b, c0.end_b) if c0 is not None else None,
+                (c1.start_b, c1.end_b) if c1 is not None else None,
+            ),
+        ))
+    return groups
+
+
+class AnchoredMerge:
+    """The change groups of one merge and their state in the result."""
+
+    def __init__(self, left, base, right, result=None):
+        self.left = list(left)
+        self.base = list(base)
+        self.right = list(right)
+        self.groups = build_groups(self.left, self.base, self.right)
+        self.dismissed: Dict[Tuple[int, int], List[str]] = {}
+        self._wand_cache: Dict[int, Optional[List[str]]] = {}
+        # Preferred readings for ambiguous text: each group's previous text,
+        # and the text an arrow just put in (it arrives as a delete and an
+        # insert, so it must outlast the first of the two).
+        self._previous: Dict[int, List[str]] = {}
+        self._acted: Dict[int, List[str]] = {}
+        self.result: Sequence[str] = list(self.base if result is None else result)
+        # Hidden two-way differ: sequence 1 is the result, sequence 0 the
+        # base, so its chunks run result (a) -> base (b).
+        self._base_differ = Differ()
+        for _ in self._base_differ.set_sequences_iter([self.base, self.result]):
+            pass
+        self.ranges: List[Range] = []
+        self._remap()
+
+    # -- texts ---------------------------------------------------------------
+
+    def side_lines(self, group: Group, side: int) -> List[str]:
+        rng = group.sides[side]
+        if rng is None:
+            return self.base[group.base[0]:group.base[1]]
+        text = self.left if side == LEFT else self.right
+        return text[rng[0]:rng[1]]
+
+    def base_lines(self, group: Group) -> List[str]:
+        return self.base[group.base[0]:group.base[1]]
+
+    def result_lines(self, index: int) -> List[str]:
+        start, end = self.ranges[index]
+        return list(self.result[start:end])
+
+    # -- keeping up with the result --------------------------------------------
+
+    def result_changed(self, startidx: int, sizechange: int, result) -> None:
+        """Call after every edit of the result, with Meld's own arguments
+        to Differ.change_sequence and the result's current lines."""
+        # What each group held before this edit: when a later reading is
+        # ambiguous, groups keep their previous state (see _candidates).
+        self._previous = {i: self.result_lines(i) for i in range(len(self.groups))}
+        self._previous.update(self._acted)
+        self.result = result
+        self._base_differ.change_sequence(
+            1, startidx, sizechange, [self.base, result])
+        self._remap()
+
+    def _chunks(self) -> List[Chunk]:
+        return [(c.start_b, c.end_b, c.start_a, c.end_a)
+                for c in self._base_differ.diffs[0]]
+
+    def _segments(self) -> List[List[Group]]:
+        """Groups split into runs that touch in the base (one ends where
+        the next starts). Unchanged base lines separate the runs and anchor
+        them in the result; within a run, a line diff cannot tell which
+        result lines belong to which group, so _split decides by text."""
+        segments: List[List[Group]] = []
+        for group in self.groups:
+            if segments and segments[-1][-1].base[1] == group.base[0]:
+                segments[-1].append(group)
+            else:
+                segments.append([group])
+        return segments
+
+    def _remap(self) -> None:
+        parsed = self._parse()
+        if parsed is not None:
+            self.ranges = parsed
+            return
+        chunks = self._chunks()
+        self.ranges = []
+        for segment in self._segments():
+            base = (segment[0].base[0], segment[-1].base[1])
+            rng = self._map(base, chunks)
+            split = self._split(segment, rng)
+            if split is None:
+                rng, split = self._map_with_slides(segment, base, chunks, rng)
+            if split is None:
+                split = self._split_loosely(segment, rng)
+            self.ranges.extend(split)
+
+    def _parse(self) -> Optional[List[Range]]:
+        """Read the result as the base's unchanged runs ("anchors") in
+        order, with each segment of groups between them holding one of its
+        candidate texts, or, when edited by hand, any text up to where the
+        next anchor matches. This needs no diff, so look-alike lines (a
+        "}", a blank line) cannot pull a range off. Of all readings, the one
+        with the fewest hand-edited segments wins. None when an anchor
+        itself was edited; _remap then falls back to the base->result diff.
+        """
+        segments = self._segments()
+        if not segments:
+            return []
+        result = list(self.result)
+        total = len(result)
+        bounds = [0] + [x for s in segments for x in (s[0].base[0], s[-1].base[1])] + [len(self.base)]
+        anchors = [self.base[bounds[2 * k]:bounds[2 * k + 1]]
+                   for k in range(len(segments) + 1)]
+        # Where each line occurs in the result, to find anchors quickly.
+        where: Dict[str, List[int]] = {}
+        for pos, line in enumerate(result):
+            where.setdefault(line, []).append(pos)
+
+        def anchor_at(k: int, pos: int) -> bool:
+            anchor = anchors[k]
+            return result[pos:pos + len(anchor)] == anchor
+
+        def anchor_starts(k: int, lo: int) -> List[int]:
+            anchor = anchors[k]
+            if not anchor:
+                return list(range(lo, total + 1))
+            return [p for p in where.get(anchor[0], ()) if p >= lo and anchor_at(k, p)]
+
+        if not anchor_at(0, 0):
+            return None
+        # states: position after anchor k -> (hand-edited count, ranges so far)
+        states: Dict[int, Tuple[int, List[Range]]] = {len(anchors[0]): (0, [])}
+        for k, segment in enumerate(segments):
+            nxt: Dict[int, Tuple[int, List[Range]]] = {}
+
+            def offer(pos, cost, ranges):
+                if pos not in nxt or nxt[pos][0] > cost:
+                    nxt[pos] = (cost, ranges)
+
+            for start, (cost, ranges) in sorted(states.items()):
+                exact = self._splits_from(segment, result, start)
+                found = False
+                for end, split in exact:
+                    if anchor_at(k + 1, end):
+                        offer(end + len(anchors[k + 1]), cost, ranges + split)
+                        found = True
+                if found:
+                    continue
+                for end in anchor_starts(k + 1, start):
+                    split = self._split_loosely(segment, (start, end))
+                    offer(end + len(anchors[k + 1]), cost + 1, ranges + split)
+            states = nxt
+            if not states:
+                return None
+        final = states.get(total)
+        return final[1] if final is not None else None
+
+    def _splits_from(self, segment: List[Group], result: List[str],
+                     start: int) -> List[Tuple[int, List[Range]]]:
+        """Every way the segment's groups can each hold one of their
+        candidate texts, starting at start: (end, ranges), the first
+        reading per end (applied texts are tried first)."""
+        options = [self._candidates(g) for g in segment]
+        found: Dict[int, List[Range]] = {}
+
+        def walk(k: int, pos: int, ranges: List[Range]) -> None:
+            if k == len(segment):
+                found.setdefault(pos, ranges)
+                return
+            for cand in options[k]:
+                stop = pos + len(cand)
+                if result[pos:stop] == cand:
+                    walk(k + 1, stop, ranges + [(pos, stop)])
+
+        walk(0, start, [])
+        return sorted(found.items())
+
+    def _map(self, base: Range, chunks: List[Chunk]) -> Range:
+        """A base range's place in the result: shifted by every edit before
+        it and widened by every edit that touches it, insertions at either
+        end included."""
+        eff_s, eff_e = base
+        related = set()
+        changed = True
+        while changed:
+            changed = False
+            for i, (b0, b1, _r0, _r1) in enumerate(chunks):
+                if i in related:
+                    continue
+                if b0 == b1:
+                    touches = eff_s <= b0 <= eff_e
+                else:
+                    touches = (b0 < eff_e and b1 > eff_s) or b0 < eff_s < b1
+                if touches:
+                    related.add(i)
+                    eff_s, eff_e = min(eff_s, b0), max(eff_e, b1)
+                    changed = True
+
+        def delta(c: Chunk) -> int:
+            return (c[3] - c[2]) - (c[1] - c[0])
+
+        before = sum(delta(c) for i, c in enumerate(chunks)
+                     if i not in related and c[1] <= eff_s)
+        inside = sum(delta(chunks[i]) for i in related)
+        return eff_s + before, eff_e + before + inside
+
+    def _candidates(self, group: Group) -> List[List[str]]:
+        """Every text a group can hold that has a known meaning: applied
+        texts first, so when two readings give the same text the group
+        reads as applied (the result is the same either way), then base,
+        then texts it was dismissed against."""
+        texts = []
+        for side in (LEFT, RIGHT):
+            if group.sides[side] is not None:
+                texts.append(self.side_lines(group, side))
+        if group.kind == Kind.CONFLICT:
+            left = self.side_lines(group, LEFT)
+            right = self.side_lines(group, RIGHT)
+            texts += [left + right, right + left]
+            wand = self.wand_lines(group.index)
+            if wand is not None:
+                texts.append(wand)
+        texts.append(self.base_lines(group))
+        for side in (LEFT, RIGHT):
+            dismissed = self.dismissed.get((group.index, side))
+            if dismissed is not None:
+                texts.append(dismissed)
+        preferred = self._previous.get(group.index)
+        if preferred is not None and preferred in texts:
+            texts.insert(0, preferred)
+        unique = []
+        for text in texts:
+            if text not in unique:
+                unique.append(text)
+        return unique
+
+    def _split(self, segment: List[Group], rng: Range) -> Optional[List[Range]]:
+        """Divide a segment's result text among its groups so that each
+        part is one of that group's candidate texts, or None when no such
+        division exists (the text was edited by hand)."""
+        start, end = rng
+        text = list(self.result[start:end])
+        options = [self._candidates(g) for g in segment]
+        failed = set()
+
+        def walk(k: int, pos: int) -> Optional[List[Range]]:
+            if k == len(segment):
+                return [] if pos == len(text) else None
+            if (k, pos) in failed:
+                return None
+            for cand in options[k]:
+                stop = pos + len(cand)
+                if text[pos:stop] == cand:
+                    rest = walk(k + 1, stop)
+                    if rest is not None:
+                        return [(start + pos, start + stop)] + rest
+            failed.add((k, pos))
+            return None
+
+        return walk(0, 0)
+
+    def _split_loosely(self, segment: List[Group], rng: Range) -> List[Range]:
+        """For a segment edited by hand: groups that still match at either
+        end keep their text there, and one group left over takes all the
+        rest, so the typed text sits with one group whose X can keep it.
+        The end is matched first, so text typed on a boundary goes to the
+        earlier group."""
+        start, end = rng
+        text = list(self.result[start:end])
+        head, tail = [], []
+        lo, hi = 0, len(text)
+        i, j = 0, len(segment)
+        while j > i + 1:
+            match = next((c for c in self._candidates(segment[j - 1])
+                          if hi - len(c) >= lo and text[hi - len(c):hi] == c), None)
+            if match is None:
+                break
+            tail.insert(0, (start + hi - len(match), start + hi))
+            hi -= len(match)
+            j -= 1
+        while i < j - 1:
+            match = next((c for c in self._candidates(segment[i])
+                          if lo + len(c) <= hi and text[lo:lo + len(c)] == c), None)
+            if match is None:
+                break
+            head.append((start + lo, start + lo + len(match)))
+            lo += len(match)
+            i += 1
+        # Groups i..j-1 are left: the first takes the rest of the text, the
+        # others sit empty right after it.
+        middle = [(start + lo, start + hi)] + [(start + hi, start + hi)] * (j - i - 1)
+        return head + middle + tail
+
+    def _slides(self, chunks: List[Chunk], i: int) -> List[Chunk]:
+        """Positions a pure insertion or deletion can slide to over lines
+        that are identical at both of its ends, nearest first. A line diff
+        cannot tell these apart: a block ending in "}" inserted after
+        another "}" can be reported one line off."""
+        b0, b1, r0, r1 = chunks[i]
+        if b0 != b1 and r0 != r1:
+            return []
+        if b0 == b1:
+            text, lo, hi = self.result, r0, r1
+        else:
+            text, lo, hi = self.base, b0, b1
+        prev_end = chunks[i - 1][3 if b0 == b1 else 1] if i > 0 else 0
+        next_start = (chunks[i + 1][2 if b0 == b1 else 0]
+                      if i + 1 < len(chunks) else len(text))
+        down, up = [], []
+        k = 0
+        while hi + k < next_start and text[lo + k] == text[hi + k]:
+            k += 1
+            down.append(k)
+        k = 0
+        while lo - k > prev_end and text[lo - k - 1] == text[hi - k - 1]:
+            k += 1
+            up.append(-k)
+        offsets = sorted(down + up, key=abs)
+        return [(b0 + k, b1 + k, r0 + k, r1 + k) for k in offsets]
+
+    def _map_with_slides(self, segment: List[Group], base: Range,
+                         chunks: List[Chunk], fallback: Range):
+        """Try every slide of every insertion or deletion and keep the
+        first that lets the segment's text be divided among its groups;
+        sliding only crosses identical lines, so any match is the same
+        text. Returns (range, split), split None when nothing fits."""
+        for i in range(len(chunks)):
+            for slid in self._slides(chunks, i):
+                trial = chunks[:i] + [slid] + chunks[i + 1:]
+                rng = self._map(base, trial)
+                split = self._split(segment, rng)
+                if split is not None:
+                    return rng, split
+        return fallback, None
+
+    # -- state -----------------------------------------------------------------
+
+    def _is_applied(self, group: Group, side: int, text: List[str]) -> bool:
+        own = self.side_lines(group, side)
+        if group.kind != Kind.CONFLICT:
+            return text == own
+        if text == own:
+            return True
+        left = self.side_lines(group, LEFT)
+        right = self.side_lines(group, RIGHT)
+        # When one side deleted the block, applying both is the other
+        # side's text, so that text counts as both applied: the result is
+        # the same whichever was meant.
+        if text in (left + right, right + left):
+            return True
+        wand = self.wand_lines(group.index)
+        return wand is not None and text == wand
+
+    def side_state(self, index: int, side: int) -> SideState:
+        group = self.groups[index]
+        if group.sides[side] is None:
+            return SideState.NONE
+        text = self.result_lines(index)
+        if self._is_applied(group, side, text):
+            return SideState.APPLIED
+        if self.dismissed.get((index, side)) == text:
+            return SideState.DISMISSED
+        return SideState.UNRESOLVED
+
+    def is_resolved(self, index: int) -> bool:
+        return all(self.side_state(index, side) in HANDLED
+                   for side in (LEFT, RIGHT))
+
+    def counts(self) -> Tuple[int, int, int]:
+        """(changes, unresolved, conflicts): every group, the groups not yet
+        resolved, and the conflicts among those."""
+        unresolved = [g for g in self.groups if not self.is_resolved(g.index)]
+        conflicts = [g for g in unresolved if g.kind == Kind.CONFLICT]
+        return len(self.groups), len(unresolved), len(conflicts)
+
+    # -- actions ---------------------------------------------------------------
+
+    def apply(self, index: int, side: int) -> Optional[Edit]:
+        """The edit the arrow on this side makes: the side's text replaces
+        the group's result text, except on a conflict whose result is no
+        longer the base (the other side applied, or typed by hand), where it
+        is added after it."""
+        group = self.groups[index]
+        if group.sides[side] is None:
+            return None
+        start, end = self.ranges[index]
+        own = self.side_lines(group, side)
+        current = self.result_lines(index)
+        if group.kind == Kind.CONFLICT and current != self.base_lines(group):
+            edit = Edit(start, end, current + own)
+        else:
+            edit = Edit(start, end, own)
+        self._acted = {index: list(edit.lines)}
+        return edit
+
+    def dismiss(self, index: int, side: int) -> None:
+        """The X: keep the result as it is here and stop asking. A change
+        both sides made is dismissed on both."""
+        group = self.groups[index]
+        text = self.result_lines(index)
+        sides = (LEFT, RIGHT) if group.kind == Kind.BOTH else (side,)
+        for s in sides:
+            if group.sides[s] is not None:
+                self.dismissed[(index, s)] = text
+
+    def apply_non_conflicting(self, which: str) -> List[Edit]:
+        """Edits for "Apply non-conflicting changes": 'left', 'right' or
+        'all'. Last group first, so each edit leaves the ranges of the ones
+        still to apply where they were."""
+        wanted = {
+            'left': (Kind.LEFT, Kind.BOTH),
+            'right': (Kind.RIGHT, Kind.BOTH),
+            'all': (Kind.LEFT, Kind.RIGHT, Kind.BOTH),
+        }[which]
+        edits = []
+        for group in self.groups:
+            if group.kind not in wanted:
+                continue
+            side = RIGHT if group.kind == Kind.RIGHT else LEFT
+            if self.side_state(group.index, side) == SideState.UNRESOLVED:
+                edits.append(self.apply(group.index, side))
+        return sorted(edits, key=lambda e: e.start, reverse=True)
+
+    def wand_lines(self, index: int) -> Optional[List[str]]:
+        """The magic wand's merge of a conflict (wand_merge on just this
+        block), or None when it cannot merge it."""
+        if index not in self._wand_cache:
+            group = self.groups[index]
+            merged = None
+            if group.kind == Kind.CONFLICT:
+                merged = wand_merge(self.side_lines(group, LEFT),
+                                    self.base_lines(group),
+                                    self.side_lines(group, RIGHT))
+            self._wand_cache[index] = merged
+        return self._wand_cache[index]
+
+    def wand(self, index: int) -> Optional[Edit]:
+        """The wand's edit for one conflict, only while nothing has been
+        done to it yet (its result is still the base)."""
+        group = self.groups[index]
+        if (group.kind != Kind.CONFLICT or
+                self.result_lines(index) != self.base_lines(group)):
+            return None
+        merged = self.wand_lines(index)
+        if merged is None:
+            return None
+        start, end = self.ranges[index]
+        return Edit(start, end, merged)
+
+    def wand_all(self) -> List[Edit]:
+        edits = [self.wand(g.index) for g in self.groups]
+        return sorted((e for e in edits if e is not None),
+                      key=lambda e: e.start, reverse=True)
+
+
+def apply_edits(lines: List[str], edits: List[Edit]) -> List[str]:
+    """Apply edits (last first, as the model returns them) to a list of
+    lines; for whole-file writes and tests."""
+    lines = list(lines)
+    for edit in edits:
+        lines[edit.start:edit.end] = edit.lines
+    return lines
+
+
+def _geometric_tag(chunk: DiffChunk) -> str:
+    if chunk.start_a == chunk.end_a:
+        return 'insert'
+    if chunk.start_b == chunk.end_b:
+        return 'delete'
+    return 'replace'
+
+
+class AnchoredMergeDiffer(Differ):
+    """Meld's three-way differ, re-tagged from an AnchoredMerge.
+
+    The chunks stay Meld's own result<->side differences, so every real
+    difference keeps a chunk and pane alignment, link maps and next/previous
+    work unchanged. Only their tags change: 'conflict' while the group is an
+    unresolved conflict on that side, the usual insert/delete/replace while
+    that side's change is unresolved, and 'resolved' once it is handled.
+    Differences typed outside any group keep a plain tag.
+
+    The view sets base_lines before the comparison starts.
+    """
+
+    _URGENCY = {'resolved': 0, 'insert': 1, 'delete': 1, 'replace': 1,
+                'conflict': 2}
+
+    def __init__(self):
+        super().__init__()
+        self.base_lines: Optional[List[str]] = None
+        self.model: Optional[AnchoredMerge] = None
+
+    def set_sequences_iter(self, sequences):
+        if self.base_lines is not None and len(sequences) == 3:
+            self.model = AnchoredMerge(
+                list(sequences[0]), self.base_lines, list(sequences[2]),
+                list(sequences[1]))
+        yield from super().set_sequences_iter(sequences)
+
+    def change_sequence(self, sequence, startidx, sizechange, texts):
+        if self.model is not None and sequence == 1:
+            self.model.result_changed(startidx, sizechange, texts[1])
+        super().change_sequence(sequence, startidx, sizechange, texts)
+
+    def refresh(self, texts) -> None:
+        """Re-tag after a state change that edits no text (a dismissal)."""
+        self._old_merge_cache = set(self._merge_cache)
+        self._changed_chunks = tuple()
+        self._update_merge_cache(texts)
+
+    def _merge_diffs(self, seq0, seq1, texts):
+        for c0, c1 in super()._merge_diffs(seq0, seq1, texts):
+            if self.model is None:
+                yield c0, c1
+            else:
+                yield self._retag(c0, LEFT), self._retag(c1, RIGHT)
+
+    def _retag(self, chunk: Optional[DiffChunk], side: int):
+        if chunk is None:
+            return None
+        model = self.model
+        tag = None
+        for index in self._groups_over(chunk.start_a, chunk.end_a):
+            group = model.groups[index]
+            state = model.side_state(index, side)
+            if state in HANDLED:
+                candidate = 'resolved'
+            elif group.kind == Kind.CONFLICT:
+                candidate = 'conflict'
+            else:
+                candidate = _geometric_tag(chunk)
+            if tag is None or self._URGENCY[candidate] > self._URGENCY[tag]:
+                tag = candidate
+        if tag is None:
+            tag = _geometric_tag(chunk)
+        return chunk._replace(tag=tag)
+
+    def _groups_over(self, start: int, end: int) -> List[int]:
+        """Groups whose result range overlaps [start, end); an empty range
+        on either side overlaps when it touches."""
+        hits = []
+        for index, (r0, r1) in enumerate(self.model.ranges):
+            if start == end or r0 == r1:
+                if r0 <= end and start <= r1:
+                    hits.append(index)
+            elif r0 < end and start < r1:
+                hits.append(index)
+        return hits
