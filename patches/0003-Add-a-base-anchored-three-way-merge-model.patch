+    def test_applied_change_leaves_a_resolved_chunk_on_the_other_side(self):
+        d = self.make(LEFT_T, BASE, RIGHT_T)
+        do_edit(d, d.model.apply(0, LEFT), sides=(LEFT_T, RIGHT_T))
+        # No left chunk any more for c; the right pane now differs there and
+        # keeps a chunk, so the panes stay aligned, tagged resolved.
+        right_chunks = [p[1] for p in d.all_changes() if p[1] is not None]
+        self.assertIn('resolved', [c.tag for c in right_chunks])
+        self.assertEqual(self.tags(d, LEFT), ['insert', 'conflict'])
