+"""Tests for the base-anchored merge model (local patch).
+
+Assumptions pinned: texts are lists of lines without line endings, as
+Meld's BufferLines give them. A result edit reaches the model the way
+filediff reports it to Differ.change_sequence: a deletion as
+(startline, -lines_removed) and an insertion as (startline, lines_added),
+each with the result's lines after that step. Differ.change_sequence and
+Differ._merge_diffs behave as in Meld 3.24.1.
+"""
+
+import random
+import unittest
+
+from meld.matchers.anchored import (
+    LEFT,
+    RIGHT,
+    AnchoredMerge,
+    AnchoredMergeDiffer,
+    Edit,
+    Kind,
+    SideState,
+    apply_edits,
+    exit_status,
+    merge3,
+    wand_merge,
+)
+
+
+def lines(text):
+    return text.split()
+
+
+def do_edit(target, edit, sides=None):
+    """Apply an Edit to the result the way Meld reports it: delete, then
+    insert. target is an AnchoredMerge, or an AnchoredMergeDiffer with
+    sides=(left, right)."""
+    result = list(target.model.result if sides else target.result)
+    after_delete = result[:edit.start] + result[edit.end:]
+    after_insert = after_delete[:edit.start] + edit.lines + after_delete[edit.start:]
+    for size, text in ((-(edit.end - edit.start), after_delete),
+                       (len(edit.lines), after_insert)):
+        if sides:
+            target.change_sequence(1, edit.start, size, [sides[0], text, sides[1]])
+        else:
+            target.result_changed(edit.start, size, text)
+    return after_insert
+
+
+BASE = lines("a b c d e f g h i j")
+# Left: changes c (left only), inserts X after e (same on both), changes h.
+LEFT_T = lines("a b C d e X f g H i j")
+# Right: inserts X after e (same on both), changes h differently, changes j.
+RIGHT_T = lines("a b c d e X f g h2 i J")
