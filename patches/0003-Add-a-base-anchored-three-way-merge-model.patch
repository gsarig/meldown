+class RandomMergeTests(unittest.TestCase):
+    """Seeded random merges with code-like lines: many distinct lines plus
+    the look-alikes ("}", "{", blank) that make line diffs ambiguous."""
+
+    ALPHABET = ["}", "", "{", "}"] + [f"line{i}" for i in range(25)]
+
+    def mutate(self, rnd, base):
+        text = list(base)
+        for _ in range(rnd.randint(1, 3)):
+            op, pos = rnd.choice("ird"), rnd.randint(0, len(text))
+            if op == "i":
+                text[pos:pos] = [rnd.choice(self.ALPHABET) for _ in range(rnd.randint(1, 3))]
+            elif op == "r" and pos < len(text):
+                text[pos] = rnd.choice(self.ALPHABET)
+            elif op == "d" and pos < len(text):
+                del text[pos:pos + rnd.randint(1, 2)]
+        return text
+
+    def merges(self, seed, count):
+        rnd = random.Random(seed)
+        for _ in range(count):
+            base = [rnd.choice(self.ALPHABET) for _ in range(rnd.randint(5, 40))]
+            yield rnd, base, self.mutate(rnd, base), self.mutate(rnd, base)
+
+    def test_every_arrow_shows_its_change_applied(self):
+        for rnd, base, left, right in self.merges(7, 300):
+            m = AnchoredMerge(left, base, right)
+            order = list(range(len(m.groups)))
+            rnd.shuffle(order)
+            for i in order:
+                group = m.groups[i]
+                sides = [s for s in (LEFT, RIGHT) if group.sides[s] is not None]
+                if group.kind == Kind.BOTH:
+                    sides = [LEFT]
+                rnd.shuffle(sides)
+                for side in sides:
+                    if m.side_state(i, side) == SideState.UNRESOLVED:
+                        do_edit(m, m.apply(i, side))
+                        self.assertEqual(m.side_state(i, side), SideState.APPLIED,
+                                         (base, left, right))
+            self.assertEqual(m.counts()[1], 0, (base, left, right))
+            fresh = AnchoredMerge(left, base, right, list(m.result))
+            self.assertEqual(fresh.ranges, m.ranges, (base, left, right))
+
+    def test_undoing_an_arrow_brings_the_change_back(self):
+        for rnd, base, left, right in self.merges(11, 300):
+            m = AnchoredMerge(left, base, right)
+            for i, group in enumerate(m.groups):
+                side = RIGHT if group.kind == Kind.RIGHT else LEFT
+                edit = m.apply(i, side)
+                old = list(m.result[edit.start:edit.end])
+                do_edit(m, edit)
+                do_edit(m, Edit(edit.start, edit.start + len(edit.lines), old))
+                self.assertEqual(list(m.result), base, (base, left, right))
+                self.assertEqual(m.side_state(i, side), SideState.UNRESOLVED,
+                                 (base, left, right))
