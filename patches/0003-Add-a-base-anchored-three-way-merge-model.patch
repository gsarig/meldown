+        self.assertEqual(len(d.conflicts), 1)  # right side still open
+        d.model.dismiss(2, RIGHT)
+        d.refresh([LEFT_T, list(d.model.result), RIGHT_T])
+        self.assertEqual(len(d.conflicts), 0)
