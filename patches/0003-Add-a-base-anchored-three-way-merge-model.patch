+    def test_every_difference_keeps_a_chunk(self):
+        d = self.make(LEFT_T, BASE, RIGHT_T)
+        for edit in d.model.apply_non_conflicting('all'):
+            do_edit(d, edit, sides=(LEFT_T, RIGHT_T))
+        result = list(d.model.result)
+        plain = AnchoredMergeDiffer()  # no base: Meld's own chunks
+        for _ in plain.set_sequences_iter([LEFT_T, result, RIGHT_T]):
+            pass
+        strip = lambda pairs: [tuple(c[1:] if c else None for c in p) for p in pairs]
+        self.assertEqual(strip(d.all_changes()), strip(plain.all_changes()))
